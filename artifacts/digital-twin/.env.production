# Production build settings for the dedicated Climate KIC demo site (this repository).
# Visitors open the link and land straight in the Climate KIC demonstration case,
# with no /prepare step (see src/lib/lead/startCase.ts and the README).
# Not a secret. Never put keys or passwords in this file: those belong in Vercel's
# Environment Variables. A Vercel variable with the same name overrides this value.
VITE_START_CASE=climate-kic
