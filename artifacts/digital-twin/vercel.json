{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@10.34.9 install --frozen-lockfile",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/sign-loi.ts": {
      "maxDuration": 30
    },
    "api/submit-crm.ts": {
      "maxDuration": 15
    },
    "api/prepare-unlock.ts": {
      "maxDuration": 10
    }
  }
}
